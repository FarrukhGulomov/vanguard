# ─────────────────────────────────────────────
#  Vanguard Logistics — Environment Variables
#  Copy to .env and fill in real values
# ─────────────────────────────────────────────

# Server
PORT=3000
ALLOWED_ORIGIN=https://vanguarduzb.com

# ── Email (choose ONE provider below) ────────

# Option A: Yandex Mail (recommended for CIS)
# Create app-password at: https://id.yandex.ru/security/app-passwords
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@yandex.ru
SMTP_PASS=your_app_password

# Option B: Gmail
# Enable 2FA → create App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# Option C: Corporate / hosting SMTP (cPanel, Timeweb, etc.)
# SMTP_HOST=mail.vanguarduzb.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@vanguarduzb.com
# SMTP_PASS=your_mailbox_password

# ── Recipients ───────────────────────────────

# Where to send contact form submissions
RECIPIENT_EMAIL=anvarataev@vanguarduzb.com

# Admin API key to view submissions via /api/admin/submissions
# Generate a strong random key: openssl rand -hex 32
ADMIN_KEY=change_this_to_a_long_random_string
